{
  "name": "@muspellheim/stylelint-config",
  "version": "0.2.2",
  "author": "Falko Schumann",
  "license": "MIT",
  "homepage": "https://github.com/falkoschumann/muspellheim-config-js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/falkoschumann/muspellheim-config-js.git"
  },
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:types": "tsc --build tsconfig.json"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./types/mod.d.ts",
        "default": "./lib/mod.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "types"
  ],
  "dependencies": {
    "stylelint-config-standard": "40.0.0",
    "stylelint-config-standard-scss": "17.0.0"
  },
  "peerDependencies": {
    "stylelint": "17.16.0"
  },
  "devDependencies": {
    "@muspellheim/eslint-config": "*",
    "@muspellheim/typescript-config": "*",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "typescript": "6.0.3"
  }
}
