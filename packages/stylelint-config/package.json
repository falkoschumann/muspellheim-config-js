{
  "name": "@muspellheim/stylelint-config",
  "version": "0.3.0",
  "author": "Falko Schumann",
  "license": "MIT",
  "homepage": "https://github.com/falkoschumann/muspellheim-config-js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/falkoschumann/muspellheim-config-js.git"
  },
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:types": "tsc --build tsconfig.json"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./types/mod.d.ts",
        "default": "./lib/mod.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "types"
  ],
  "dependencies": {
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0",
    "stylelint-config-standard-scss": "17.0.0"
  },
  "devDependencies": {
    "@muspellheim/eslint-config": "*",
    "@muspellheim/typescript-config": "*",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "typescript": "6.0.3"
  }
}
