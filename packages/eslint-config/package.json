{
  "name": "@muspellheim/eslint-config",
  "version": "0.2.1",
  "author": "Falko Schumann",
  "license": "MIT",
  "homepage": "https://github.com/falkoschumann/muspellheim-config-js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/falkoschumann/muspellheim-config-js.git"
  },
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:types": "tsc --build tsconfig.json"
  },
  "exports": {
    ".": {
      "import": {
        "default": "./lib/mod.js",
        "types": "./types/lib.d.ts"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "types"
  ],
  "dependencies": {
    "@eslint/js": "10.0.1",
    "@softarc/eslint-plugin-sheriff": "0.20.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-headers": "1.3.4",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "typescript-eslint": "8.71.2"
  },
  "peerDependencies": {
    "eslint": "^10",
    "typescript": "^6"
  },
  "devDependencies": {
    "@muspellheim/typescript-config": "*",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "typescript": "6.0.3"
  }
}
