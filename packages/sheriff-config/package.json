{
  "name": "@muspellheim/sheriff-config",
  "version": "0.2.4",
  "author": "Falko Schumann",
  "license": "MIT",
  "homepage": "https://github.com/falkoschumann/muspellheim-config-js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/falkoschumann/muspellheim-config-js.git"
  },
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.build.json && bun build src/mod.ts --production --outdir=dist --sourcemap=linked --packages=external && bun build src/mod.ts --production --outdir=dist --sourcemap=linked --packages=external --format=cjs --entry-naming=\"[dir]/[name].cjs\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check-types": "tsc --build tsconfig.json"
  },
  "main": "./dist/mod.cjs",
  "module": "./dist/mod.js",
  "types": "./dist/types/mod.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/mod.d.ts",
        "default": "./dist/mod.js"
      },
      "require": {
        "types": "./dist/types/mod.d.ts",
        "default": "./dist/mod.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "peerDependencies": {
    "@softarc/sheriff-core": "^0.20"
  },
  "devDependencies": {
    "@muspellheim/eslint-config": "*",
    "@muspellheim/typescript-config": "*",
    "@softarc/sheriff-core": "0.20.0",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "typescript": "6.0.3"
  }
}
