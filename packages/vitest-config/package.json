{
  "name": "@muspellheim/vitest-config",
  "version": "0.1.0",
  "author": "Falko Schumann",
  "license": "MIT",
  "homepage": "https://github.com/falkoschumann/muspellheim-config-js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/falkoschumann/muspellheim-config-js.git"
  },
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.build.json && bun build src/mod.ts --production --outdir=dist --sourcemap=linked --packages=external",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check-types": "tsc --build tsconfig.json"
  },
  "exports": {
    ".": {
      "import": {
        "default": "./dist/mod.js",
        "types": "./dist/types/mod.d.ts"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@vitest/coverage-v8": "5.0.5"
  },
  "peerDependencies": {
    "vitest": "^5"
  },
  "devDependencies": {
    "@muspellheim/eslint-config": "*",
    "@muspellheim/typescript-config": "*",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
